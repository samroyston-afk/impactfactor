<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<!-- Keeps this page out of Google and other search engines. Remove this line if you later want the site to be findable. -->
<meta name="robots" content="noindex, nofollow">
<title>How impact ready is your research? - Impact Factor</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --navy:#1A3A5C;--teal:#0B8A7A;--amber:#E8A020;--white:#fff;
  --light:#EEF7F5;--light2:#F5FAFA;--text:#162030;--mid:#3D5A73;--muted:#6A8FA8;
  --teal-light:#5ED8C8;--amber-light:#F4C87A;--red:#C0392B;
}
html{scroll-behavior:smooth}
body{font-family:'Lato',sans-serif;color:var(--text);background:var(--light2);line-height:1.6}
.wrap{max-width:760px;margin:0 auto;padding:0 1.5rem}

/* HEADER */
header{background:var(--navy);padding:1.1rem 0}
.hd{display:flex;align-items:center;justify-content:space-between;gap:1rem}
.brand{display:flex;align-items:center;gap:.6rem;text-decoration:none}
.brand .w1{font-weight:700;font-size:.92rem;letter-spacing:.08em;color:#fff;display:block;line-height:1.1}
.brand .w2{font-size:.8rem;letter-spacing:.1em;color:var(--teal-light);display:block;line-height:1.1}
.back{font-size:.85rem;color:rgba(255,255,255,.6);text-decoration:none;font-weight:700}
.back:hover{color:#fff}

/* CARD */
main{padding:3rem 0 4rem}
.card{background:#fff;border:1px solid #e0edeb;border-radius:10px;padding:2.5rem}
h1{font-family:'Playfair Display',serif;font-size:2rem;line-height:1.2;color:var(--navy);margin-bottom:1rem}
h2{font-family:'Playfair Display',serif;font-size:1.4rem;color:var(--navy);line-height:1.3}
p{color:var(--mid)}
.eyebrow{font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--amber);display:block;margin-bottom:.7rem}
.lead{font-size:1.05rem;margin-bottom:1rem}
.meta{font-size:.9rem;color:var(--muted);margin:1.5rem 0 2rem;padding-top:1.25rem;border-top:1px solid #eef3f2}
.btn{display:inline-block;background:var(--amber);color:var(--navy);padding:.85rem 1.9rem;border:none;border-radius:4px;font-family:'Lato',sans-serif;font-weight:700;font-size:.93rem;letter-spacing:.03em;cursor:pointer;text-decoration:none;transition:background .2s}
.btn:hover{background:#d49218}
.btn[disabled]{background:#dfe7e6;color:#9bb0ae;cursor:not-allowed}
.btn-quiet{background:none;border:none;color:var(--muted);font-family:'Lato',sans-serif;font-size:.86rem;text-decoration:underline;cursor:pointer;padding:0}
.btn-quiet:hover{color:var(--mid)}

/* PROGRESS */
.prog-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:.6rem}
.prog-label{font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--teal)}
.prog-count{font-size:.8rem;color:var(--muted)}
.prog-track{height:4px;background:#e6eeed;border-radius:2px;overflow:hidden;margin-bottom:2.25rem}
.prog-fill{height:100%;background:var(--teal);border-radius:2px;transition:width .35s ease}

/* QUESTIONS */
.q{margin-bottom:2rem}
.q:last-of-type{margin-bottom:1rem}
.q-text{font-size:1.08rem;font-weight:700;color:var(--navy);margin-bottom:.9rem;line-height:1.45}
.opt{display:block;width:100%;text-align:left;background:#fff;border:1px solid #dde8e6;border-radius:6px;padding:.8rem 1rem;margin-bottom:.5rem;font-family:'Lato',sans-serif;font-size:.95rem;color:var(--mid);cursor:pointer;transition:border-color .15s,background .15s}
.opt:hover{border-color:var(--teal);background:var(--light2)}
.opt.sel{border-color:var(--teal);background:var(--light);color:var(--navy);font-weight:700}
.nav-row{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-top:2rem;padding-top:1.5rem;border-top:1px solid #eef3f2}

/* RESULTS */
.res-top{text-align:center;padding-bottom:2rem;border-bottom:1px solid #eef3f2;margin-bottom:2rem}
.ring-wrap{position:relative;width:170px;height:170px;margin:0 auto 1.25rem}
.ring-num{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
.ring-num .n{font-family:'Playfair Display',serif;font-size:2.7rem;font-weight:700;color:var(--navy);line-height:1}
.ring-num .of{font-size:.8rem;color:var(--muted);letter-spacing:.05em}
.level{font-family:'Playfair Display',serif;font-size:1.7rem;font-weight:700;margin-bottom:.75rem}
.res-sum{font-size:1.02rem;max-width:520px;margin:0 auto}
.sec-title{font-size:.75rem;font-weight:700;letter-spacing:.11em;text-transform:uppercase;color:var(--teal);margin-bottom:1.25rem}
.block{margin-bottom:2.5rem}
.dim{margin-bottom:1rem}
.dim-head{display:flex;justify-content:space-between;font-size:.9rem;margin-bottom:.35rem}
.dim-head .nm{font-weight:700;color:var(--navy)}
.dim-head .sc{color:var(--muted);font-size:.85rem}
.dim-track{height:7px;background:#e9f0ef;border-radius:4px;overflow:hidden}
.dim-fill{height:100%;border-radius:4px;transition:width .8s ease}
.radar{display:block;margin:0 auto;max-width:100%}
.tip{background:var(--light);border-left:3px solid var(--amber);border-radius:0 5px 5px 0;padding:1.15rem 1.35rem;margin-bottom:.85rem}
.tip h3{font-family:'Lato',sans-serif;font-size:.95rem;font-weight:700;color:var(--navy);margin-bottom:.35rem}
.tip p{font-size:.93rem;line-height:1.6}
.cta{background:var(--teal);border-radius:8px;padding:2rem;text-align:center;margin-top:2.5rem}
.cta h3{font-family:'Playfair Display',serif;font-size:1.35rem;color:#fff;margin-bottom:.75rem}
.cta p{color:rgba(255,255,255,.85);font-size:.97rem;max-width:460px;margin:0 auto 1.5rem}
.cta a{display:inline-block;background:#fff;color:var(--teal);padding:.8rem 1.9rem;border-radius:4px;font-weight:700;font-size:.93rem;text-decoration:none}
.cta a:hover{background:#f0faf9}
.retake{text-align:center;margin-top:1.5rem}
.hidden{display:none}
footer{padding:2rem 0 3rem;text-align:center}
footer p{font-size:.82rem;color:var(--muted)}
footer a{color:var(--teal);text-decoration:none}

@media(max-width:640px){
  .card{padding:1.75rem 1.35rem}
  h1{font-size:1.6rem}
  main{padding:2rem 0 3rem}
}
</style>
</head>
<body>

<header>
  <div class="wrap hd">
    <a href="index.html" class="brand">
      <svg width="34" height="34" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="44" height="44" rx="7" fill="#0B8A7A"/>
        <rect x="32" y="0" width="12" height="12" rx="3" fill="#E8A020"/>
        <text x="5" y="34" font-family="Georgia,serif" font-size="28" font-weight="bold" fill="white">IF</text>
      </svg>
      <span><span class="w1">IMPACT</span><span class="w2">FACTOR</span></span>
    </a>
    <a href="index.html" class="back">Back to the site</a>
  </div>
</header>

<main>
  <div class="wrap">

    <!-- INTRO -->
    <section class="card" id="intro">
      <span class="eyebrow">Self-assessment</span>
      <h1>How impact ready is your research?</h1>
      <p class="lead">Most researchers know their work could matter beyond the academy. Far fewer have the foundations in place for that to happen: the audiences identified, the relationships built, the evidence captured as it goes.</p>
      <p>This asks twelve questions across six dimensions of impact readiness. It takes about five minutes, and gives you a profile showing where you are strong and where the gaps are.</p>
      <p class="meta">Nothing is recorded or sent anywhere. Your answers stay in your browser and disappear when you close the tab.</p>
      <button class="btn" id="start">Start the assessment</button>
    </section>

    <!-- QUESTIONS -->
    <section class="card hidden" id="quiz">
      <div class="prog-head">
        <span class="prog-label" id="secName">Planning and strategy</span>
        <span class="prog-count" id="secCount">Section 1 of 6</span>
      </div>
      <div class="prog-track"><div class="prog-fill" id="progFill" style="width:0%"></div></div>
      <div id="qArea"></div>
      <div class="nav-row">
        <button class="btn-quiet hidden" id="back">Back</button>
        <span></span>
        <button class="btn" id="next" disabled>Next</button>
      </div>
    </section>

    <!-- RESULTS -->
    <section class="card hidden" id="results">
      <div class="res-top">
        <div class="ring-wrap">
          <svg width="170" height="170" viewBox="0 0 170 170">
            <circle cx="85" cy="85" r="72" fill="none" stroke="#e9f0ef" stroke-width="12"/>
            <circle id="ring" cx="85" cy="85" r="72" fill="none" stroke="#0B8A7A" stroke-width="12"
                    stroke-linecap="round" transform="rotate(-90 85 85)"
                    stroke-dasharray="452" stroke-dashoffset="452"
                    style="transition:stroke-dashoffset 1.1s ease"/>
          </svg>
          <div class="ring-num"><span class="n" id="scoreNum">0</span><span class="of">out of 48</span></div>
        </div>
        <div class="level" id="levelName"></div>
        <p class="res-sum" id="levelSummary"></p>
      </div>

      <div class="block">
        <div class="sec-title">Your profile</div>
        <svg class="radar" id="radar" width="380" height="320" viewBox="0 0 380 320"></svg>
      </div>

      <div class="block">
        <div class="sec-title">Dimension by dimension</div>
        <div id="dims"></div>
      </div>

      <div class="block">
        <div class="sec-title">Where to start</div>
        <div id="tips"></div>
      </div>

      <p id="levelDetail" style="font-size:.97rem"></p>

      <div class="cta">
        <h3>Does this match what you see?</h3>
        <p id="ctaText"></p>
        <a href="mailto:hello@impactfactor.co.uk">hello@impactfactor.co.uk</a>
      </div>

      <div class="retake"><button class="btn-quiet" id="retake">Take it again</button></div>
    </section>

  </div>
</main>

<footer>
  <div class="wrap"><p>Impact Factor. <a href="index.html">Back to the site</a></p></div>
</footer>

<script>
// ---- Assessment content ----------------------------------------------------
var SECTIONS = [
  { id:"planning", title:"Planning and strategy", short:"Planning", questions:[
    { text:"How clearly have you articulated the potential real-world impact of your research?", opts:[
      "I have not thought about it in concrete terms",
      "I have a general sense of it but nothing written down",
      "I have written it down, at least in outline",
      "I have a clear plan naming the specific changes I am aiming for"]},
    { text:"Do you have a plan for how your research will reach the people who could act on it?", opts:[
      "No plan at all",
      "Some ideas, not yet organised",
      "A plan for this particular project",
      "A plan that runs across my work, not just one project"]}
  ]},
  { id:"stakeholders", title:"Stakeholder engagement", short:"Stakeholders", questions:[
    { text:"How well do you know who would need to act for your research to make a difference?", opts:[
      "I could not name them",
      "I could name a few organisations",
      "I have a list of named individuals and organisations",
      "I have mapped them and know which ones matter most"]},
    { text:"How early do you involve those audiences in your work?", opts:[
      "I share findings once the work is finished",
      "Towards the end, when the results are firming up",
      "At points during the project",
      "From the design stage, and they shape the questions"]}
  ]},
  { id:"communication", title:"Communication", short:"Communication", questions:[
    { text:"How comfortable are you writing about your research for a non-academic audience?", opts:[
      "Not at all, I find it difficult",
      "I can do it, but it takes a long time",
      "Reasonably comfortable",
      "Confident, and I have formats I reuse"]},
    { text:"Have you produced anything aimed at a policy or practice audience, such as a briefing?", opts:[
      "No",
      "A blog post or something similar",
      "Yes, at least one briefing or equivalent",
      "Regularly, and tailored to particular audiences"]}
  ]},
  { id:"evidence", title:"Evidence and documentation", short:"Evidence", questions:[
    { text:"Are you recording evidence of engagement and influence as it happens?", opts:[
      "No",
      "Occasionally, in scattered places",
      "Yes, in one place, though not consistently",
      "Yes, systematically, with dates and sources"]},
    { text:"If you were asked tomorrow to show your research had changed something, what could you produce?", opts:[
      "Very little",
      "Download and citation figures",
      "Some correspondence or meeting records",
      "Documented decisions, citations in policy, or testimony from the people who used it"]}
  ]},
  { id:"networks", title:"Networks and relationships", short:"Networks", questions:[
    { text:"How strong are your relationships with organisations outside the academy in your field?", opts:[
      "I have none",
      "A few contacts, mostly one-off",
      "Several relationships I could call on",
      "Established relationships built over years"]},
    { text:"Do people outside academia approach you for your expertise?", opts:[
      "Never",
      "Rarely",
      "Occasionally",
      "Regularly, and it is part of how I work"]}
  ]},
  { id:"ref", title:"REF and institutional support", short:"REF", questions:[
    { text:"How well do you understand what REF panels mean by reach and significance?", opts:[
      "Not at all",
      "I have heard the terms",
      "I understand them broadly",
      "I understand how they apply to my own work"]},
    { text:"How well connected are you to your institution's impact support?", opts:[
      "I do not know who they are",
      "I know they exist",
      "I have spoken to them at least once",
      "I work with them regularly"]}
  ]}
];

var TIPS = {
  planning:"Start with a one-page impact plan mapping your findings to specific real-world outcomes. A theory of change diagram, even a rough sketch, is a good first step.",
  stakeholders:"Set aside half a day to map your stakeholder landscape: who needs to know, who needs to act, and how best to reach them. The earlier in the project, the better.",
  communication:"Draft a two-page briefing that puts your findings in language a decision maker can use. Focus on the problem, the evidence, and what follows for policy or practice.",
  evidence:"Start an impact evidence log today, a simple spreadsheet noting the date, the type of engagement, the reach, and any documentation. Evidence gathered after the fact is much weaker.",
  networks:"Pick two or three organisations or individuals in your sector and make a concrete plan to approach them this quarter. Relationships take time, so starting early matters.",
  ref:"Get familiar with the REF impact criteria, in particular what reach and significance mean and how your work maps against them. Your institution's impact manager is the person to ask."
};

var LEVELS = [
  { min:38, name:"Impact Champion", colour:"#0B8A7A",
    summary:"You have strong foundations in place. The audiences are identified, the relationships exist, and the evidence is being captured as you go.",
    detail:"At this level the gains come from sharpening rather than building: making the strongest case for what has already happened, and spotting the opportunities that are easy to miss from inside a project.",
    cta:"If the picture here rings true, or misses something, I would like to hear which." },
  { min:26, name:"Impact Developer", colour:"#E8A020",
    summary:"You have a solid grasp of research impact and some good practice in place, but there are gaps that would repay attention.",
    detail:"This is the stage where focused effort tends to pay off most, because the underlying work is strong and what is missing is usually the connective tissue between the research and the people who could use it.",
    cta:"If this matches your experience, or gets it wrong, I would like to hear which." },
  { min:0,  name:"Impact Starter", colour:"#C0392B",
    summary:"Your research has real potential for impact, but the foundations are not yet in place to realise it.",
    detail:"There is a lot of ground that can be covered quickly from here. It is rarely too early to start, and later than you would like is still better than not at all.",
    cta:"If this reading of where you are is useful, or wrong, I would like to hear which." }
];

// ---- State -----------------------------------------------------------------
var answers = {}, secIdx = 0;
var el = function(id){ return document.getElementById(id); };

function renderSection(){
  var sec = SECTIONS[secIdx];
  el("secName").textContent = sec.title;
  el("secCount").textContent = "Section " + (secIdx+1) + " of " + SECTIONS.length;
  el("progFill").style.width = ((secIdx)/SECTIONS.length*100) + "%";

  var html = "";
  sec.questions.forEach(function(q, qi){
    var key = sec.id + "-" + qi;
    html += '<div class="q"><div class="q-text">' + q.text + '</div>';
    q.opts.forEach(function(o, oi){
      var sel = answers[key] === (oi+1) ? " sel" : "";
      html += '<button class="opt' + sel + '" data-key="' + key + '" data-val="' + (oi+1) + '">' + o + '</button>';
    });
    html += '</div>';
  });
  el("qArea").innerHTML = html;

  Array.prototype.forEach.call(el("qArea").querySelectorAll(".opt"), function(b){
    b.addEventListener("click", function(){
      answers[b.dataset.key] = parseInt(b.dataset.val, 10);
      renderSection();
    });
  });

  el("back").classList.toggle("hidden", secIdx === 0);
  el("next").textContent = (secIdx === SECTIONS.length-1) ? "See my results" : "Next";
  var done = sec.questions.every(function(q, qi){ return answers[sec.id + "-" + qi]; });
  el("next").disabled = !done;
  window.scrollTo({ top:0, behavior:"smooth" });
}

function dimScores(){
  return SECTIONS.map(function(sec){
    var v = sec.questions.reduce(function(t,q,qi){ return t + (answers[sec.id+"-"+qi]||0); }, 0);
    return { id:sec.id, short:sec.short, title:sec.title, value:v };
  });
}

function showResults(){
  el("quiz").classList.add("hidden");
  el("results").classList.remove("hidden");
  window.scrollTo({ top:0, behavior:"smooth" });

  var dims = dimScores();
  var total = dims.reduce(function(t,d){ return t + d.value; }, 0);
  var level = LEVELS.filter(function(l){ return total >= l.min; })[0];

  el("levelName").textContent = level.name;
  el("levelName").style.color = level.colour;
  el("levelSummary").textContent = level.summary;
  el("levelDetail").textContent = level.detail;
  el("ctaText").textContent = level.cta;

  // score ring: 12 is the floor, 48 the ceiling
  var frac = Math.max(0, (total - 12) / 36);
  setTimeout(function(){
    el("ring").setAttribute("stroke", level.colour);
    el("ring").style.strokeDashoffset = String(452 - 452*frac);
  }, 120);

  // count up
  var n = 0, step = Math.max(1, Math.round(total/28));
  var timer = setInterval(function(){
    n += step;
    if (n >= total){ n = total; clearInterval(timer); }
    el("scoreNum").textContent = n;
  }, 32);

  // dimension bars
  var dh = "";
  dims.forEach(function(d){
    var pct = (d.value - 2) / 6 * 100;
    var col = d.value >= 7 ? "#0B8A7A" : (d.value >= 5 ? "#E8A020" : "#C0392B");
    dh += '<div class="dim"><div class="dim-head"><span class="nm">' + d.title +
          '</span><span class="sc">' + d.value + ' / 8</span></div>' +
          '<div class="dim-track"><div class="dim-fill" style="width:' + Math.max(pct,2) +
          '%;background:' + col + '"></div></div></div>';
  });
  el("dims").innerHTML = dh;

  drawRadar(dims);

  // two weakest dimensions
  var weakest = dims.slice().sort(function(a,b){ return a.value - b.value; }).slice(0,2);
  var th = "";
  weakest.forEach(function(d){
    th += '<div class="tip"><h3>' + d.title + '</h3><p>' + TIPS[d.id] + '</p></div>';
  });
  el("tips").innerHTML = th;
}

function drawRadar(dims){
  var cx = 190, cy = 155, R = 110, n = dims.length;
  var pt = function(i, r){
    var a = (Math.PI*2*i/n) - Math.PI/2;
    return [cx + Math.cos(a)*r, cy + Math.sin(a)*r];
  };
  var s = "";
  // grid rings
  [0.25,0.5,0.75,1].forEach(function(f){
    var pts = [];
    for (var i=0;i<n;i++){ pts.push(pt(i, R*f).join(",")); }
    s += '<polygon points="' + pts.join(" ") + '" fill="none" stroke="#dfeae8" stroke-width="1"/>';
  });
  // spokes
  for (var i=0;i<n;i++){
    var p = pt(i, R);
    s += '<line x1="' + cx + '" y1="' + cy + '" x2="' + p[0] + '" y2="' + p[1] + '" stroke="#dfeae8" stroke-width="1"/>';
  }
  // data
  var dpts = [];
  dims.forEach(function(d, i){
    var f = (d.value - 2) / 6;
    dpts.push(pt(i, Math.max(R*f, 4)).join(","));
  });
  s += '<polygon points="' + dpts.join(" ") + '" fill="#0B8A7A" fill-opacity="0.22" stroke="#0B8A7A" stroke-width="2"/>';
  dims.forEach(function(d, i){
    var f = (d.value - 2) / 6;
    var p = pt(i, Math.max(R*f, 4));
    s += '<circle cx="' + p[0] + '" cy="' + p[1] + '" r="3.5" fill="#0B8A7A"/>';
  });
  // labels
  dims.forEach(function(d, i){
    var p = pt(i, R + 24);
    var anchor = Math.abs(p[0]-cx) < 12 ? "middle" : (p[0] > cx ? "start" : "end");
    s += '<text x="' + p[0] + '" y="' + (p[1]+4) + '" text-anchor="' + anchor +
         '" font-family="Lato,sans-serif" font-size="11" font-weight="700" fill="#3D5A73">' + d.short + '</text>';
  });
  el("radar").innerHTML = s;
}

// ---- Wiring ----------------------------------------------------------------
el("start").addEventListener("click", function(){
  el("intro").classList.add("hidden");
  el("quiz").classList.remove("hidden");
  renderSection();
});
el("next").addEventListener("click", function(){
  if (secIdx === SECTIONS.length-1){ showResults(); }
  else { secIdx++; renderSection(); }
});
el("back").addEventListener("click", function(){
  if (secIdx > 0){ secIdx--; renderSection(); }
});
el("retake").addEventListener("click", function(){
  answers = {}; secIdx = 0;
  el("results").classList.add("hidden");
  el("intro").classList.remove("hidden");
  el("ring").style.strokeDashoffset = "452";
  window.scrollTo({ top:0, behavior:"smooth" });
});
</script>
</body>
</html>
